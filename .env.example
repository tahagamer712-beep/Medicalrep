# نسخة نموذجية — انسخها إلى .env وعبّئ القيم الحقيقية هناك فقط.
# لا تضع أسرارًا حقيقية في هذا الملف ولا ترفعه أبدًا.

# معرّفات Telegram الرقمية للـ Owner (مفصولة بفواصل) — تُثبت بعد التحقق
TELEGRAM_OWNER_IDS=

# توكن بوت Telegram الخاص بالـ Owner
TELEGRAM_OWNER_BOT_TOKEN=

# مسار مجلد البيانات (قواعد SQLite + النسخ الاحتياطية)
DATA_DIR=./data

# ملاحظة: مفاتيح تشفير النسخ تُولَّد تلقائيًا لكل مكتب في DATA_DIR/keys/
# انسخها خارج الجهاز — فقدانها يعني فقدان النسخ.

# البيئة: dev / prod
APP_ENV=dev

# وضع إرسال التذكيرات: log (الافتراضي الآمن — تسجيل فقط دون إرسال حقيقي)
# أو telegram (إرسال حقيقي — لا تفعّله إلا بموافقة صريحة بعد اختبار البوت)
REMINDER_DELIVERY=log

# --- WhatsApp Business Platform (Cloud API) — تُعبأ عند التفعيل فقط ---
# رمز تحقق تُخترعه أنت وتضعه في لوحة Meta عند إعداد الـ webhook
WHATSAPP_VERIFY_TOKEN=
# سر التطبيق من Meta (App settings) — يُستخدم للتحقق من توقيع الأحداث
WHATSAPP_APP_SECRET=
# معرّف رقم الهاتف من لوحة WhatsApp
WHATSAPP_PHONE_NUMBER_ID=
# توكن System User بصلاحية whatsapp_business_messaging
WHATSAPP_ACCESS_TOKEN=
# إصدار API (الافتراضي v21.0)
WHATSAPP_API_VERSION=v21.0
